{
  "name": "@streamplugins/server",
  "version": "0.1.0",
  "description": "StreamPlugins backend server -- OAuth, API proxy, WebSocket manager, Discord forwarder",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist --format=esm",
    "build:pkg": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/pkg.cjs --format=cjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
