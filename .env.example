# StreamPlugins local server configuration
# Copy this file to:
#   Windows: %APPDATA%\StreamPlugins\.env
#   macOS:   ~/Library/Application Support/StreamPlugins/.env
#   Linux:   ~/.config/StreamPlugins/.env
#
# Or place in the project root for development (npm run dev).

STREAMPLUGINS_PORT=3847

# Twitch — https://dev.twitch.tv/console/apps
# Redirect URI: http://localhost:3847/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube (Google OAuth) — https://console.cloud.google.com/
# Redirect URI: http://localhost:3847/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Kick — https://kick.com/settings/developer
# Redirect URI: http://localhost:3847/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
